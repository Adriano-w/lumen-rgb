{
  "name": "lumen",
  "version": "0.1.0",
  "description": "Controle unificado de iluminacao RGB para Windows",
  "private": true,
  "type": "module",
  "main": "./out/main/index.mjs",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "start": "electron-vite preview",
    "probe:build": "tsc -p tsconfig.scripts.json",
    "probe": "npm run probe:build && node .probe/scripts/probe-devices.js",
    "probe:effects": "npm run probe:build && node .probe/scripts/probe-effects.js",
    "dist": "electron-vite build && electron-builder --win nsis",
    "restore": "npm run probe:build && node .probe/scripts/restore-hardware.js",
    "probe:buses": "npm run probe:build && node .probe/scripts/probe-buses.js",
    "probe:smbus": "npm run probe:build && node .probe/scripts/probe-smbus-devices.js",
    "probe:argb": "npm run probe:build && node .probe/scripts/probe-argb.js",
    "probe:stability": "npm run probe:build && node .probe/scripts/probe-stability.js",
    "probe:sync": "npm run probe:build && node .probe/scripts/probe-sync.js",
    "demo:sync": "npm run probe:build && node .probe/scripts/demo-sync.js",
    "probe:span": "npm run probe:build && node .probe/scripts/probe-span.js"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-store": "^12.0.0",
    "koffi": "^3.3.3",
    "node-hid": "^3.4.0"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@uiw/react-color": "^2.10.3",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.60.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "zustand": "^5.0.15"
  },
  "license": "GPL-2.0-or-later",
  "author": "Adriano",
  "homepage": "https://github.com/Adriano-w/lumen-rgb",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Adriano-w/lumen-rgb.git"
  },
  "bugs": {
    "url": "https://github.com/Adriano-w/lumen-rgb/issues"
  }
}
